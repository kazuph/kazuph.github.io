diff --git a/webapp/go/notifications.go b/webapp/go/notifications.go
new file mode 100644
index 0000000..4fb0fb3
--- /dev/null
+++ b/webapp/go/notifications.go
@@ -0,0 +1,93 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sync"
+)
+
+var notificationSignals = struct {
+	sync.Mutex
+	channels map[string]chan struct{}
+}{channels: make(map[string]chan struct{})}
+
+func notificationSignal(key string) <-chan struct{} {
+	notificationSignals.Lock()
+	defer notificationSignals.Unlock()
+	ch, ok := notificationSignals.channels[key]
+	if !ok {
+		ch = make(chan struct{})
+		notificationSignals.channels[key] = ch
+	}
+	return ch
+}
+
+func notify(key string) {
+	notificationSignals.Lock()
+	defer notificationSignals.Unlock()
+	if ch, ok := notificationSignals.channels[key]; ok {
+		close(ch)
+		delete(notificationSignals.channels, key)
+	}
+}
+
+func notifyRide(ride *Ride) {
+	notify("user:" + ride.UserID)
+	if ride.ChairID.Valid {
+		notify("chair:" + ride.ChairID.String)
+	}
+}
+
+func resetNotifications() {
+	notificationSignals.Lock()
+	defer notificationSignals.Unlock()
+	for key, ch := range notificationSignals.channels {
+		close(ch)
+		delete(notificationSignals.channels, key)
+	}
+}
+
+// Subscribe before reading the database: commits racing with the read cannot be missed.
+func serveNotifications[T any](w http.ResponseWriter, r *http.Request, key string, fetch func() (*T, bool, error)) {
+	var previous []byte
+	started := false
+	for {
+		changed := notificationSignal(key)
+		data, pending, err := fetch()
+		if err != nil {
+			if !started {
+				writeError(w, http.StatusInternalServerError, err)
+			}
+			return
+		}
+		payload, err := json.Marshal(data)
+		if err != nil {
+			return
+		}
+		if !started {
+			w.Header().Set("Content-Type", "text/event-stream")
+			w.Header().Set("Cache-Control", "no-cache")
+			w.Header().Set("X-Accel-Buffering", "no")
+			started = true
+		}
+		if !bytes.Equal(previous, payload) {
+			if _, err := fmt.Fprintf(w, "data: %s\n\n", payload); err != nil {
+				return
+			}
+			if err := http.NewResponseController(w).Flush(); err != nil {
+				return
+			}
+			previous = payload
+		}
+		if pending {
+			continue
+		}
+		select {
+		case <-r.Context().Done():
+			return
+		case <-changed:
+		}
+	}
+}
