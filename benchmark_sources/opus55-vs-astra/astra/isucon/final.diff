+++ b/webapp/sql/verify-invariants.sql
@@ -0,0 +1,33 @@
+USE isuride;
+START TRANSACTION WITH CONSISTENT SNAPSHOT;
+SELECT 'distance_mismatches', COUNT(*)
+FROM (
+    SELECT chair_id, SUM(COALESCE(distance,0)) AS distance
+    FROM (
+        SELECT chair_id,
+          ABS(latitude-LAG(latitude) OVER (PARTITION BY chair_id ORDER BY created_at,id)) +
+          ABS(longitude-LAG(longitude) OVER (PARTITION BY chair_id ORDER BY created_at,id)) AS distance
+        FROM chair_locations
+    ) steps GROUP BY chair_id
+) totals LEFT JOIN chair_location_summaries s ON s.chair_id=totals.chair_id
+WHERE s.chair_id IS NULL OR totals.distance<>s.total_distance;
+SELECT 'latest_location_mismatches', COUNT(*)
+FROM (
+    SELECT chair_id, latitude, longitude, created_at,
+      ROW_NUMBER() OVER (PARTITION BY chair_id ORDER BY created_at DESC,id DESC) AS position
+    FROM chair_locations
+) locations LEFT JOIN chair_location_summaries s ON s.chair_id=locations.chair_id
+WHERE position=1 AND (s.chair_id IS NULL OR locations.latitude<>s.latitude OR locations.longitude<>s.longitude OR locations.created_at<>s.updated_at);
+SELECT 'evaluation_completion_mismatches', COUNT(*) FROM rides r
+WHERE (r.evaluation IS NOT NULL) <> EXISTS (SELECT 1 FROM ride_statuses s WHERE s.ride_id=r.id AND s.status='COMPLETED');
+SELECT 'double_booked_chairs', COUNT(*) FROM (
+    SELECT chair_id FROM rides WHERE chair_id IS NOT NULL AND evaluation IS NULL GROUP BY chair_id HAVING COUNT(*)>1
+) duplicate_chairs;
+SELECT 'duplicate_coupon_use', COUNT(*) FROM (
+    SELECT used_by FROM coupons WHERE used_by IS NOT NULL GROUP BY used_by HAVING COUNT(*)>1
+) duplicate_coupons;
+SELECT 'invalid_model_speed', COUNT(*) FROM chair_models WHERE speed<=0;
+SELECT 'existing_completed_rides_excluded_from_stats', COUNT(*) FROM rides r WHERE evaluation IS NOT NULL AND
+  (NOT EXISTS (SELECT 1 FROM ride_statuses s WHERE s.ride_id=r.id AND s.status='CARRYING') OR
+   NOT EXISTS (SELECT 1 FROM ride_statuses s WHERE s.ride_id=r.id AND s.status='ARRIVED'));
+COMMIT;
