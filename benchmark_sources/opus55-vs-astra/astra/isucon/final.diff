new file mode 100644
index 0000000..0badeb9
--- /dev/null
+++ b/webapp/sql/4-location-summaries.sql
@@ -0,0 +1,10 @@
+INSERT INTO chair_location_summaries (chair_id, latitude, longitude, total_distance, updated_at)
+SELECT chair_id, MAX(latest_latitude), MAX(latest_longitude), SUM(distance), MAX(created_at)
+FROM (
+  SELECT chair_id, created_at,
+    FIRST_VALUE(latitude) OVER (PARTITION BY chair_id ORDER BY created_at DESC, id DESC) AS latest_latitude,
+    FIRST_VALUE(longitude) OVER (PARTITION BY chair_id ORDER BY created_at DESC, id DESC) AS latest_longitude,
+    COALESCE(ABS(latitude - LAG(latitude) OVER (PARTITION BY chair_id ORDER BY created_at, id)) +
+             ABS(longitude - LAG(longitude) OVER (PARTITION BY chair_id ORDER BY created_at, id)), 0) AS distance
+  FROM chair_locations
+) locations GROUP BY chair_id;
