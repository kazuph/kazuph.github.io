+++ b/webapp/go/notifications_test.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestNotificationSignals(t *testing.T) {
+	resetNotifications()
+	user := notificationSignal("user:test")
+	chair := notificationSignal("chair:test")
+	notify("user:test")
+	select {
+	case <-user:
+	default:
+		t.Fatal("user missed committed event")
+	}
+	select {
+	case <-chair:
+		t.Fatal("unrelated chair was notified")
+	default:
+	}
+	next := notificationSignal("user:test")
+	select {
+	case <-next:
+		t.Fatal("new subscription already closed")
+	default:
+	}
+	resetNotifications()
+	select {
+	case <-next:
+	default:
+		t.Fatal("initialization did not wake user")
+	}
+	select {
+	case <-chair:
+	default:
+		t.Fatal("initialization did not wake chair")
+	}
+}
+
+func TestConcurrentNotificationPublishAndReset(t *testing.T) {
+	var workers sync.WaitGroup
+	for i := 0; i < 64; i++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for j := 0; j < 64; j++ {
+				ch := notificationSignal("user:concurrent")
+				notify("user:concurrent")
+				<-ch
+				resetNotifications()
+			}
+		}()
+	}
+	workers.Wait()
+}
