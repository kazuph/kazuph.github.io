{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buzzer-quiz",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "dev": {
    "ip": "localhost",
    "port": 8781,
    "inspector_port": 0
  }
}
