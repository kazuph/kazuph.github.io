{
  "name": "pi-benchmark-buzzer-dependencies",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "devDependencies": {
    "wrangler": "4.149.0",
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@cloudflare/workers-types": "5.20261006.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "24.5.2"
  },
  "scripts": {
    "dev": "CLOUDFLARE_CF_FETCH_ENABLED=false wrangler dev --port 8787 --inspector-port 0 --log-level warn",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "shots": "playwright test tests/e2e/screenshots.spec.ts"
  }
}
