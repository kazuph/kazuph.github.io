{
  "name": "buzzer-quiz",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    "QUESTION_MS": "20000",
    "ANSWER_MS": "10000",
    "REVEAL_MS": "4000"
  },
  "env": {
    "test": {
      "vars": {
        "QUESTION_MS": "2000",
        "ANSWER_MS": "800",
        "REVEAL_MS": "500"
      },
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
      }
    }
  },
  "observability": { "enabled": false }
}
