// 早押しクイズ — Cloudflare Workers + Durable Objects
// ローカル開発専用: `wrangler dev` で http://localhost:8787 で動く（デプロイ・ログイン不要）
{
  "name": "buzzer-quiz",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  // 静的ファイル（クライアント SPA）は Workers Assets で配信
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] }
  ],
  "observability": {
    "enabled": true
  }
}
