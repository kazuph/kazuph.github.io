{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": [
    "worker-configuration.d.ts",
    "node_modules/@cloudflare/vitest-pool-workers/types/cloudflare-test.d.ts",
    "src/**/*.ts",
    "test/integration/**/*.ts"
  ]
}
