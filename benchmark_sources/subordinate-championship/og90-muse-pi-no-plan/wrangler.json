{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.jsonschema.json",
  "name": "buzzer-quiz",
  "main": "src/worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  "dev": {
    "port": 8787,
    "ip": "127.0.0.1"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
