{
  "name": "buzzer-quiz",
  "version": "0.1.0",
  "private": true,
  "description": "4人オンライン早押しクイズ（Cloudflare Workers・ローカル開発専用）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8792 --inspector-port 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  }
}
