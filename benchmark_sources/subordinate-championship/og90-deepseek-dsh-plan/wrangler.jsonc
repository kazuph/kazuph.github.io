{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buzzer-quiz",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "inspector_port": 0
  }
}
