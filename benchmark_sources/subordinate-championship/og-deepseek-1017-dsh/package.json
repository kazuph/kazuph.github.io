{
  "name": "buzzer-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "4人オンライン対戦の早押しクイズ (Cloudflare Workers + Durable Objects, ローカル開発限定)",
  "scripts": {
    "dev": "node scripts/dev.mjs --port 8787",
    "dev:e2e": "node scripts/dev.mjs --port 8899 --var QUESTION_MS:9000 --var ANSWER_MS:6000 --var REVEAL_MS:1200",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/shots.mjs"
  },
  "devDependencies": {
    "wrangler": "4.149.0",
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@cloudflare/workers-types": "5.20261006.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "24.5.2"
  }
}
