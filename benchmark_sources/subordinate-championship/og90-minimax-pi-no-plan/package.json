{
  "name": "buzzer-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "4人オンライン対戦の早押しクイズ（Cloudflare Workers + Durable Objects）",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:plain": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:workers && npm run test:e2e",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "wrangler": "4.149.0",
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@cloudflare/workers-types": "5.20261006.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "24.5.2"
  }
}
